history/
pending/
logs/
data/
docs/
archive/
settings/
knowledge/
build/
.tmp/
contexts/agents-evolution/

# secrets — never commit
.env
*.pem
*.key
.git-credentials
.netrc

__pycache__/
*.pyc
*.bak.*

# per-install rule/tip overlays (personal / domain)
contexts/local/
