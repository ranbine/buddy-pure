# machine-specific config (may contain absolute paths / identity)
config/local.env
config/gate-policy.local.json
config/local.json
config/auto-archive.local.sh

# CodeBuddy per-checkout overrides (the host adds this itself as well)
.codebuddy/settings.local.json
CODEBUDDY.local.md

