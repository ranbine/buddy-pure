# Copy to config/local.env (gitignored) and adjust. Values here MAY be absolute.
#
# cbp-cli state dir (sessions, installed agents). Default: $HOME/.codebuddy
# CBP_CLI_HOME=
#
# cbp-cli binary. Default: first `cbp-cli` on PATH
# CBP_CLI_BIN=
#
# Profile used to render agents/ and preferences
CBP_USER_NAME="Your Name"
CBP_USER_HANDLE=yourhandle
CBP_USER_EMAIL=you@example.com
# Report timezone (IANA). Unset → machine zone (/etc/localtime). The action gate defaults to UTC.
# CBP_TZ=
#
# Optional: only paths under these prefixes may be proposed for deletion
# (colon-separated, relative to $HOME or absolute)
# CBP_DELETE_ALLOW=
#
# --- action gate (bin/action-gate.py, .codebuddy/rules/gate-policy.json) ---
# Values that would cover everything ('/', $HOME, the repo, ~/.codebuddy or a parent of them) are rejected
# and the gate fails closed.
# Your own scratch dirs: writes there are L1, deletes *inside* them are L1 (colon-separated)
# CBP_SCRATCH_DIRS=
# Per-user tmp prefix; default /tmp/<login>-
# CBP_TMP_PREFIX=
# Mail recipients treated as "self" (L1); default CBP_USER_EMAIL (comma-separated)
# CBP_SELF_EMAILS=
# Agents that carry gate hooks (gate-install.py); calling any other agent is L3
# CBP_GATED_AGENTS=pure,reviewer,html-generator,health-checker
#
# Per-agent tool budgets added/overridden for agent-perf / agent-trace (name=N, comma-separated)
# CBP_AGENT_BUDGETS=
#
# Personal gate rules (internal MCP servers, extra L1 tools, mode) go in
# config/gate-policy.local.json — see config/gate-policy.local.example.json
#
# --- misc ---
# Startup digest heading name (agentSpawn hook)
# CBP_DIGEST_NAME=pure
# check-drift registries (space-separated, repo-relative)
# CBP_DRIFT_REGISTRIES="contexts/tips/INDEX.md .codebuddy/rules/analysis-checklist.md"
# Site-specific weekly cleanup: put shell lines in config/auto-archive.local.sh (gitignored)
# Mail sender for report emails (s-nail -r); unset = system default
# CBP_MAIL_FROM=
# Published site base URL (used in review emails) and CI pipelines page
# CBP_PAGES_URL=
# CBP_CI_URL=
#
# Peer install whose shared core (shared-files.txt) must stay identical; cbp-doctor warns on drift
# CBP_SHARED_PEER=
# Issue-key regex for insight's TR/issue scan (default: generic PROJ-123)
# CBP_ISSUE_KEY_RE=
