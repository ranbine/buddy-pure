# codebuddy-pure — unified path registry (single source of truth)
#
# Every path here is RELATIVE to the repo root ($CBP_ROOT).
# Scripts never hard-code paths: shell sources bin/lib/paths.sh,
# Python imports bin/lib/cbp_paths.py, docs reference the KEY names.
#
# Machine-specific overrides go in config/local.env (gitignored).
# Format: KEY=relative/path   (no quotes, no spaces, no leading "/")

# --- framework (tracked) ---
CBP_EXT=.codebuddy
CBP_CONTEXTS=contexts
CBP_RULES=.codebuddy/rules
CBP_TIPS=contexts/tips
CBP_BIN=bin
CBP_AGENTS=.codebuddy/agents
CBP_COMMANDS=.codebuddy/commands
CBP_SKILLS=.codebuddy/skills
CBP_HOOKS=.codebuddy/hooks
CBP_TEMPLATES=templates
CBP_DECISIONS=decisions
CBP_CONFIG=config

# --- runtime state (gitignored, created on demand) ---
CBP_HISTORY=history
CBP_PENDING=pending
CBP_LOGS=logs
CBP_DATA=data
CBP_DOCS=docs
CBP_ARCHIVE=archive
CBP_SETTINGS=settings
CBP_KNOWLEDGE=knowledge
CBP_BUILD=build
CBP_TMP=.tmp
