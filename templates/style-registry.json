      "TITLE_ZH",
      "TITLE_EN",
      "SUBTITLE_ZH",
      "SUBTITLE_EN",
      "EYEBROW_ZH",
      "EYEBROW_EN",
      "CARDS",
      "EXTRA",
      "EXTRA_CSS",
      "CTA_ZH",
      "CTA_EN",
      "CTA_HREF",
      "GEN_DATE"
    ],
    "card_markup": "<div class=\"card\"><div class=\"card-icon\">①</div><h3 data-zh=\"中文\" data-en=\"English\">English</h3><p data-zh=\"中文\" data-en=\"English\">English</p><span class=\"tag\" data-zh=\"中文\" data-en=\"English\">English</span></div>  (tag optional; all visible text via data-zh/data-en; no CJK in svg)",
    "extra_markup": "<section class=\"extra\"><h2 data-zh=\"…\" data-en=\"…\">…</h2>…</section>  or empty string; section CSS goes in {{EXTRA_CSS}} (head), not inline <style>",
    "link_depth": "docs/showcase/*.html → ../index.html, ../cbp-base.css"
  }
